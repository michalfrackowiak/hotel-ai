# Optional local overrides for Docker Compose.
HOTEL_PORT=8080
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
BOOKING_API_KEY=
HOTEL_MODEL_API_KEY=
HOTEL_MODEL_BASE_URL=https://api.openai.com/v1
HOTEL_OLLAMA_URL=http://host.docker.internal:11434
HOTEL_OLLAMA_TIMEOUT=30
HOTEL_DEMO_ADMIN_USERNAME=
HOTEL_DEMO_ADMIN_PASSWORD=

# Optional private parser review. See docs/parser-training.md.
HOTEL_PARSER_TRAINING_ENABLED=0

# Static speech-plan preflight only. No hosts/images approved by default.
# See docs/speech-plan-preflight.md for reserved budgets and the JSON schema.
HOTEL_SPEECH_HOST_POLICIES={}

# Optional read-only controller snapshot in private admin. Disabled by default.
# Keep the bearer token private. See docs/speech-admin-inventory.md.
HOTEL_SPEECH_CONTROLLER_URL=
HOTEL_SPEECH_CONTROLLER_TOKEN=
HOTEL_SPEECH_CONTROLLER_HOST=

# Optional inbound phone service. See docs/phone-booking.md.
HOTEL_PHONE_PORT=8081
HOTEL_TELEPHONY_PUBLIC_BASE_URL=
HOTEL_PHONE_RECEPTION_NUMBER=
HOTEL_TWILIO_AUTH_TOKEN=

# Optional booking confirmation worker. See docs/booking-confirmations.md.
HOTEL_SMTP_HOST=
HOTEL_SMTP_PORT=
HOTEL_SMTP_USER=
HOTEL_SMTP_PASSWORD=
HOTEL_SMTP_SSL=0
HOTEL_CONFIRMATION_FROM=
HOTEL_TWILIO_ACCOUNT_SID=
HOTEL_TWILIO_SMS_FROM=
