[Unit]
Description=Hotel AI private routed speech controller
BindsTo=docker.service
After=docker.service
RequiresMountsFor=/opt/hotel-ai-speech/boot /var/lib/hotel-ai-speech

[Service]
Type=exec
User=hotel-ai-speech
Group=hotel-ai-speech
SupplementaryGroups=docker
WorkingDirectory=/opt/hotel-ai-speech/boot
EnvironmentFile=/var/lib/hotel-ai-speech/operator/controller.env
UMask=0077
NoNewPrivileges=yes
ExecStartPre=+/usr/bin/python3 -B -m speech_controller.pilot_service web-check /var/lib/hotel-ai-speech/operator/web.json
ExecStart=/usr/bin/python3 -B -m speech_controller.runtime --config /var/lib/hotel-ai-speech/state/controller.json --boot-workers
ExecStartPost=/usr/bin/python3 -B -m speech_controller.pilot_service wait-controller /var/lib/hotel-ai-speech/state/controller.json
Restart=no
KillSignal=SIGINT
TimeoutStartSec=180
TimeoutStopSec=60
